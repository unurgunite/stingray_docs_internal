module Docscribe
  module CLI
    module Run
      type run_ctx = { pwd: Pathname, display_path: String, options: Formatters::opts, state: Formatters::state, conf: Config }

      type pool = { paths: Array[String], state: Formatters::state, options: Formatters::opts, conf: Config, pwd: Pathname, mutex: Mutex, error_mutex: Mutex }

      type rewrite_result = { output: String, changes: Array[Formatters::change] }

      INITIAL_RUN_STATE: Formatters::state
      PARALLEL_DEFAULT_THREADS: Integer

      CLI_OVERRIDE_KEYS: Array[Symbol]

      def self.run: (options: Formatters::opts, argv: Array[String]) -> Integer

      def self.run_via_server: (options: Formatters::opts, argv: Array[String]) -> Integer

      def self.build_light_config: (Formatters::opts options) -> Config

      def self.extract_cli_overrides: (Formatters::opts options) -> Hash[String, Object]

      def self.run_files_via_server: (Server::Client client, Array[String] paths, Formatters::opts options) -> Integer

      def self.build_config: (Formatters::opts options) -> Config

      def self.run_stdin: (options: Formatters::opts, conf: Config) -> Integer

      def self.stdin_rewrite_result: (Formatters::opts options, Config conf) -> rewrite_result

      def self.core_rbs_provider_for: (Config conf) -> (Types::RBS::Provider | nil)

      def self.filtered_paths: (Array[String] argv, Config conf) -> Array[String]

      def self.no_files_found: () -> Integer

      def self.ensure_server_running!: (?config_path: String?) -> void

      def self.wait_for_server: (?timeout: Integer, ?config_path: String?) -> void

      def self.process_one_file_via_server: (Docscribe::Server::Client client, String path, options: Formatters::opts, pwd: Pathname, state: Formatters::state) -> void

      def self.send_server_request: (Docscribe::Server::Client client, String path, Formatters::opts options) -> (Hash[String, Object] | nil)

      def self.server_error: (String path, Formatters::state state, String message) -> void

      def self.dispatch_server_result: (Hash[String, Object] result, Array[Formatters::change] file_changes, String path, **run_ctx ctx) -> void

      def self.write_server_result: (Hash[String, Object] result, Array[Formatters::change] file_changes, display_path: String, options: Formatters::opts, state: Formatters::state) -> void

      def self.handle_via_server_check: (String path, file_changes: Array[Formatters::change], display_path: String, options: Formatters::opts, state: Formatters::state) -> void

      def self.report_check_failure: (String display_path, Array[Formatters::change] file_changes, Formatters::opts options) -> void

      def self.update_check_failure_state: (String path, Array[Formatters::change] file_changes, Formatters::state state) -> void

      def self.symbolize_change: (Hash[String, Object] change) -> Formatters::change

      def self.expand_paths: (Array[String] args) -> Array[String]

      def self.append_expanded_path: (Array[String] files, String path) -> void

      def self.run_files: (options: Formatters::opts, conf: Config, paths: Array[String]) -> Integer

      def self.run_files_parallel: (options: Formatters::opts, conf: Config, paths: Array[String]) -> Integer

      private

      def self.merge_state: (Formatters::state target, Formatters::state source, Mutex mutex) -> void

      def self.finalize_run: (Formatters::opts options, Formatters::state state) -> void

      def self.run_exit_code: (Formatters::opts options, Formatters::state state) -> (0 | 1 | 2)

      def self.initial_run_state: () -> Formatters::state

      def self.process_one_file: (String path, options: Formatters::opts, conf: Config, pwd: Pathname, state: Formatters::state) -> void

      def self.report_progress: (Formatters::state state, Formatters::opts options, String display_path) -> void

      def self.dispatch_file_result: (String path, src: String, out: String, file_changes: Array[Formatters::change], **run_ctx ctx) -> void

      def self.display_path_for: (String path, pwd: Pathname) -> String

      def self.read_source_for_path: (String path, display_path: String, options: Formatters::opts, state: Formatters::state) -> (String | nil)

      def self.rewrite_result_for_path: (String path, src: String, ctx: run_ctx) -> (rewrite_result | nil)

      def self.record_rewrite_error: (String path, StandardError error, run_ctx ctx) -> void

      def self.handle_check_result: (String path, src: String, out: String, file_changes: Array[Formatters::change], **run_ctx ctx) -> void

      def self.real_changes?: (Array[Formatters::change] file_changes) -> bool

      def self.validated_mismatch?: (run_ctx ctx, Array[Formatters::change] type_mismatches, String out, String src, bool has_real_changes) -> bool

      def self.validate_types_enabled?: (run_ctx ctx) -> bool

      def self.no_real_changes?: (String out, String src, bool has_real_changes) -> bool

      def self.handle_validated_type_mismatch: (String path, Array[Formatters::change] file_changes, Array[Formatters::change] type_mismatches, run_ctx ctx) -> void

      def self.track_validated_mismatch: (Array[Formatters::change] type_mismatches, run_ctx ctx) -> void

      def self.handle_no_changes: (String path, Array[Formatters::change] type_mismatches, run_ctx ctx) -> void

      def self.handle_failed_check: (String path, Array[Formatters::change] file_changes, run_ctx ctx) -> void

      def self.type_mismatch_changes: (Array[Formatters::change] file_changes) -> Array[Formatters::change]

      def self.handle_check_no_changes: (String path, type_mismatches: Array[Formatters::change], display_path: String, options: Formatters::opts, state: Formatters::state) -> void

      def self.handle_check_failed: (String path, file_changes: Array[Formatters::change], display_path: String, options: Formatters::opts, state: Formatters::state) -> void

      def self.handle_write_result: (String path, src: String, out: String, file_changes: Array[Formatters::change], **run_ctx ctx) -> void

      def self.apply_correction: (String path, String out, Array[Formatters::change] file_changes, run_ctx ctx) -> void

      def self.update_correction_state: (Formatters::state state, String display_path, Array[Formatters::change] file_changes) -> void

      def self.log_write_verdict: (String verdict, String display_path, Array[Formatters::change] file_changes, Formatters::opts options) -> void

      def self.print_check_explanations: (Array[Formatters::change] file_changes) -> void

      def self.record_write_error: (String path, StandardError error, display_path: String, options: Formatters::opts, state: Formatters::state) -> void

      def self.log_check_verdict: (String verdict, String display_path, Formatters::opts options) -> void

      def self.print_check_summary: (state: Formatters::state, options: Formatters::opts) -> void

      def self.print_check_status_line: (Formatters::state state) -> void

      def self.all_fine?: (Formatters::state state, Integer checked_error, Integer type_mismatch_count) -> bool

      def self.mismatch_only?: (Formatters::state state, Integer checked_error) -> bool

      def self.build_failure_line: (Formatters::state state, Integer type_mismatch_count, Integer checked_error) -> String

      def self.run_parallel_workers: (Formatters::opts options, Config conf, Array[String] paths, Formatters::state state) -> void

      def self.parallel_worker: (pool pool) -> Thread

      def self.fetch_work: (Array[String] paths, Mutex mutex) -> String?

      def self.run_and_merge: (String path, pool pool) -> void

      def self.handle_worker_error: (StandardError exception, String path, Formatters::state state, Mutex error_mutex) -> void

      def self.merge_state_flags: (Formatters::state target, Formatters::state source) -> void

      def self.merge_state_counts: (Formatters::state target, Formatters::state source) -> void

      def self.merge_state_arrays: (Formatters::state target, Formatters::state source) -> void

      def self.merge_state_hashes: (Formatters::state target, Formatters::state source) -> void

      public

      def self.print_fail_paths: (Formatters::state state, Formatters::opts options) -> void

      def self.print_type_mismatch_paths: (Formatters::state state, Formatters::opts options) -> void

      def self.format_change_reason: (Formatters::change change) -> String

      def self.change_line_suffix: (Formatters::change change) -> String

      def self.change_method_suffix: (Formatters::change change) -> String

      def self.direct_message_change?: (Formatters::change change) -> bool

      def self.print_write_summary: (state: Formatters::state, options: Formatters::opts) -> void

      def self.print_corrected_paths: (Formatters::state state, Formatters::opts options) -> void

      def self.print_error_paths: (Formatters::state state) -> void
    end
  end
end
