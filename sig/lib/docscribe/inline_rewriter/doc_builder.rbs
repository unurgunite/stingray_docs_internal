module Docscribe
  module InlineRewriter
    module DocBuilder
      type setup = {
        node: Parser::AST::Node,
        name: Symbol,
        indent: String,
        scope: Symbol,
        visibility: Symbol,
        container: String,
        method_symbol: String,
        ?external_sig: Types::MethodSignature?,
        ?normal_type: String,
        ?rescue_specs: Array[[Array[String], String]]
      }

      type parseInfo = {
        param_names: Hash[String, bool],
        param_types: Hash[String, String],
        param_descriptions: Hash[String, String],
        raise_types: Hash[String, bool],
        plugin_tags: Hash[String, bool],
        has_return: bool,
        return_type: String?,
        return_description: String?,
        has_private: bool,
        has_protected: bool,
        has_module_function_note: bool,
        description: Array[String],
        last_tag: Symbol?,
        last_param: String?,
        note_lines: Array[Array[String]]
      }

      type returnsSpec = {
        normal: String,
        rescues: Array[[Array[String], String]]
      }

      type changeReason = {
        type: Symbol,
        message: String,
        ?source: String,
        ?extra: Hash[Symbol, top]
      }

      type missingMergeResult = {
        lines: Array[String],
        reasons: Array[Hash[Symbol, untyped]]
      }

      PARAM_TYPE_COLLECTORS: Hash[Symbol, ^(Parser::AST::Node, Hash[String, String], (Types::MethodSignature | nil), Config) -> void]

